#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build"

if command -v qmake6 >/dev/null 2>&1; then
  QMAKE=qmake6
elif command -v qmake >/dev/null 2>&1; then
  QMAKE=qmake
else
  echo "qmake6 or qmake is required to build omawrite." >&2
  exit 1
fi

JOBS="$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1)"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

"$QMAKE" "$ROOT/omawrite.pro"
make -j"$JOBS"

if [ "$(uname -s)" = "Darwin" ]; then
  # The bundle loads Qt from where it is installed. Sign it ad hoc so the
  # bundle's resources are sealed along with the binary the linker signed.
  codesign --force --sign - Omawrite.app
  echo "Built $BUILD_DIR/Omawrite.app"
else
  echo "Built $BUILD_DIR/omawrite"
fi

#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build-dmg"
APP="$BUILD_DIR/Write.app"
VERSION="$(sed -n 's/^VERSION = //p' "$ROOT/write.pro")"
DMG="$BUILD_DIR/Write-$VERSION.dmg"

if [ -z "$VERSION" ]; then
  echo "No VERSION in write.pro" >&2
  exit 1
fi

if [ -n "${WRITE_NOTARY_PROFILE:-}" ] && [ -z "${WRITE_SIGNING_IDENTITY:-}" ]; then
  echo "Notarizing needs WRITE_SIGNING_IDENTITY too." >&2
  exit 1
fi

# Qt's own macOS binaries, not Homebrew's. Homebrew builds Qt and the
# libraries it loads for the macOS it runs on, so an app made from them opens on
# no earlier one. Qt's run on Qt's minimum, macOS 14.4 for Qt 6.12, on Intel and
# Apple silicon alike, and load nothing but macOS's own libraries.
QT="${WRITE_QT:-$HOME/Qt/6.12.0/macos}"
if [ ! -x "$QT/bin/qmake" ]; then
  echo "No Qt in $QT. Install Qt's own macOS binaries there, or point WRITE_QT at them:" >&2
  echo "  uvx --from aqtinstall aqt install-qt mac desktop 6.12.0 clang_64 --archives qtbase qtsvg -m qtimageformats -O ~/Qt" >&2
  exit 1
fi
QT_PLUGINS="$QT/plugins"

# The plugins Write uses. macdeployqt on its own would copy every plugin the
# Qt install has.
PLUGINS="
platforms/libqcocoa
styles/libqmacstyle
iconengines/libqsvgicon
imageformats/libqgif
imageformats/libqicns
imageformats/libqico
imageformats/libqjpeg
imageformats/libqmacheif
imageformats/libqmacjp2
imageformats/libqsvg
imageformats/libqtga
imageformats/libqtiff
imageformats/libqwbmp
imageformats/libqwebp
"

# Every Mach-O file in the bundle, one per line.
binaries() {
  find "$APP" -type f | while IFS= read -r file; do
    case "$(file -b "$file")" in
      Mach-O*) echo "$file" ;;
    esac
  done
}

rpaths() {
  otool -l "$1" | awk '$1 == "cmd" && $2 == "LC_RPATH" { getline; getline; print $2 }'
}

# A clean build, since a new VERSION in write.pro doesn't rebuild on its own.
rm -rf "$BUILD_DIR"
BUILD_DIR="$BUILD_DIR" QMAKE="$QT/bin/qmake" "$ROOT/bin/build"

for plugin in $PLUGINS; do
  mkdir -p "$APP/Contents/PlugIns/$(dirname "$plugin")"
  cp -L "$QT_PLUGINS/$plugin.dylib" "$APP/Contents/PlugIns/$plugin.dylib"
done

# Copies in the Qt frameworks the app and its plugins load, and points them at
# each other inside the bundle.
"$QT/bin/macdeployqt" "$APP" -no-plugins -no-codesign

# macdeployqt writes qt.conf only when it deploys the plugins itself. Without
# it, Qt would look for plugins where Qt is installed.
printf '[Paths]\nPlugins = PlugIns\n' > "$APP/Contents/Resources/qt.conf"

# Clear what still points outside the app: install names some libraries keep
# from where they were built, and run paths to where Qt is installed.
binaries | while IFS= read -r file; do
  id="$(otool -D "$file" | tail -n +2 | head -n 1)"
  case "$id" in
    /*)
      install_name_tool -id "@executable_path/../Frameworks/${file#"$APP/Contents/Frameworks/"}" "$file"
      ;;
  esac
  rpaths "$file" | sort -u | while IFS= read -r rpath; do
    case "$rpath" in
      /*) install_name_tool -delete_rpath "$rpath" "$file" ;;
    esac
  done
done

# The app loads nothing from outside itself but macOS's own libraries.
leftovers="$(binaries | while IFS= read -r file; do
  { otool -L "$file" | awk '/^[[:space:]]/ { print $1 }'; rpaths "$file"; } |
    grep -v -e '^@' -e '^/System/' -e '^/usr/lib/' | sort -u | sed "s|^|${file#"$APP/"}: |"
done)"
if [ -n "$leftovers" ]; then
  echo "These still load from outside the app:" >&2
  echo "$leftovers" >&2
  exit 1
fi

# Nor anything that needs a newer macOS than the app says it does, which macOS
# would refuse to load.
MINIMUM="$(/usr/libexec/PlistBuddy -c 'Print :LSMinimumSystemVersion' "$APP/Contents/Info.plist")"
newer="$(binaries | while IFS= read -r file; do
  otool -arch all -l "$file" | awk '$1 == "minos" { print $2 }' | sort -u |
    while IFS= read -r minos; do
      if [ "$(printf '%s\n%s\n' "$minos" "$MINIMUM" | sort -V | tail -n 1)" != "$MINIMUM" ]; then
        echo "${file#"$APP/"}: macOS $minos"
      fi
    done
done)"
if [ -n "$newer" ]; then
  echo "These need a newer macOS than $MINIMUM:" >&2
  echo "$newer" >&2
  exit 1
fi

# Ad hoc by default. With a Developer ID, sign for the hardened runtime, which
# notarization requires.
if [ -n "${WRITE_SIGNING_IDENTITY:-}" ]; then
  codesign --force --deep --options runtime --timestamp \
    --sign "$WRITE_SIGNING_IDENTITY" "$APP"
else
  codesign --force --deep --sign - "$APP"
fi
codesign --verify --deep --strict "$APP"

# Notarize when given a notarytool keychain profile, made with
# xcrun notarytool store-credentials. The app gets a ticket of its own, so a
# copy taken off the disk image opens without asking Apple first.
if [ -n "${WRITE_NOTARY_PROFILE:-}" ]; then
  ditto -c -k --keepParent "$APP" "$BUILD_DIR/Write.zip"
  xcrun notarytool submit "$BUILD_DIR/Write.zip" \
    --keychain-profile "$WRITE_NOTARY_PROFILE" --wait
  rm "$BUILD_DIR/Write.zip"
  xcrun stapler staple "$APP"
fi

STAGING="$BUILD_DIR/dmg"
mkdir "$STAGING"
ditto "$APP" "$STAGING/Write.app"
ln -s /Applications "$STAGING/Applications"
hdiutil create -volname Write -srcfolder "$STAGING" -format UDZO -ov "$DMG"
rm -rf "$STAGING"

if [ -n "${WRITE_SIGNING_IDENTITY:-}" ]; then
  codesign --sign "$WRITE_SIGNING_IDENTITY" --timestamp "$DMG"
fi

if [ -n "${WRITE_NOTARY_PROFILE:-}" ]; then
  xcrun notarytool submit "$DMG" --keychain-profile "$WRITE_NOTARY_PROFILE" --wait
  xcrun stapler staple "$DMG"
fi

echo "Made $DMG"

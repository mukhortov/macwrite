#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
APPLICATIONS="${APPLICATIONS:-/Applications}"

"$ROOT/bin/build"

# Replace the whole bundle, so nothing from an older build lingers inside it.
rm -rf "$APPLICATIONS/Macwrite.app"
cp -R "$ROOT/build/Macwrite.app" "$APPLICATIONS/"

echo "Installed $APPLICATIONS/Macwrite.app"
